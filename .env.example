# =============================================================
# Saju Project Environment Variables Template (.env.example)
# 배포 환경(Render, Vercel 등) 환경변수 설정 시 참고용
# =============================================================

# Google Gemini API Key (Google AI Studio에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# PortOne (아임포트) 결제 연동 키 (선택 사항)
PORTONE_API_KEY=your_portone_api_key_here
PORTONE_API_SECRET=your_portone_api_secret_here
PORTONE_STORE_ID=your_store_id_here

# 토스페이(Toss Pay) 결제 연동 키 (서버 전용, 절대 프론트엔드에 노출 금지)
# 테스트: sk_test_... / 실거래: sk_live_...
TOSS_PAY_API_KEY=your_toss_pay_api_key_here

# 토스페이 콜백/복귀 URL로 사용할 공개 주소 (예: https://your-domain.vercel.app)
# 미설정 시 요청 Host 기준 자동 생성
PUBLIC_BASE_URL=https://your-domain.vercel.app

# 결제 검증 토큰 서명 키 (선택, 미설정 시 TOSS_PAY_API_KEY 사용)
PAYMENT_TOKEN_SECRET=your_random_secret_here

# CORS 허용 도메인 (쉼표 구분, 프로덕션 배포 시 반드시 설정)
ALLOWED_ORIGINS=https://your-domain.vercel.app

# 관리자 API 키 (saju-history 조회 시 인증용)
ADMIN_API_KEY=your_admin_api_key_here

# 서버 포트 (Render 등 클라우드 배포 시 자동 주입)
PORT=8000
